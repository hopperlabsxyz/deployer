PRIVATE_KEY=0x1223...

# Optional. When set, used as the RPC for every chain Alchemy supports
# (eth, base, arb, opt, polygon, linea, unichain, worldchain, sonic, berachain,
#  mantle, avax, bsc). Chains Alchemy does not support (hyperevm, tac, katana,
#  plasma, sei, monad, hemi) keep their viem default RPC.
ALCHEMY_API_KEY=

# Per-chain RPC override. Takes precedence over ALCHEMY_API_KEY and the viem default.
# Format: RPC_URL_<chainId>=<url>
# Examples:
# RPC_URL_1=https://ethereum-rpc.publicnode.com
# RPC_URL_8453=https://base-rpc.publicnode.com
